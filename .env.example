# MetaTrader 5 Broker Configuration
MT5_ACCOUNT=336774910
MT5_SERVER=XMGlobal-MT5
MT5_PASSWORD=your_trading_password_here

# Machine Learning & AI Settings
ONNX_MODEL_PATH=ai_brain.onnx
MIN_WIN_PROBABILITY=0.55
RETRAIN_FREQUENCY_HOURS=24

# Execution & Risk Management
MAX_ALLOWED_LOT=0.10
MAX_DOLLAR_LOSS_PER_TRADE=30.00
MAX_OPEN_TRADES=50
CIRCUIT_BREAKER_MAX_DRAWDOWN_PCT=10.0
